00,"created_at":"2026-03-11","updated_at":"2026-09-02"},{"id":2,"slug":"ffmpeg-batch-hevc","title":"批量转 HEVC 并保留文件名","category_id":4,"summary":"目录内批量把 H.264 视频转成 H.265，Apple 设备需加 hvc1 tag。","shell":"bash","os_scope":"any","danger":"safe","needs_admin":0,"needs_network":0,"doc_url":"https://ffmpeg.org/ffmpeg.html","sort_weight":90,"created_at":"2026-01-08","updated_at":"2026-10-11"},{"id":3,"slug":"win-reset-proxy","title":"清除 Windows 系统代理设置","category_id":5,"summary":"某些工具退出后会残留代理配置，导致全局断网，用这条清掉。","shell":"powershell","os_scope":"windows","danger":"caution","needs_admin":1,"needs_network":0,"doc_url":null,"sort_weight":80,"created_at":"2026-05-19","updated_at":"2026-08-30"},{"id":4,"slug":"docker-prune-all","title":"清理 Docker 无用镜像与卷","category_id":6,"summary":"释放磁盘空间，会删除所有未被容器引用的镜像、网络与构建缓存。","shell":"bash","os_scope":"linux","danger":"dangerous","needs_admin":1,"needs_network":0,"doc_url":"https://docs.docker.com/engine/reference/commandline/system_prune/","sort_weight":70,"created_at":"2025-12-04","updated_at":"2026-09-27"},{"id":5,"slug":"ssh-local-forward","title":"SSH 本地端口转发","category_id":5,"summary":"把远端服务的端口映射到本机，常用于访问只监听内网地址的数据库或面板。","shell":"bash","os_scope":"any","danger":"safe","needs_admin":0,"needs_network":1,"doc_url":"https://www.ssh.com/academy/ssh/tunneling","sort_weight":60,"created_at":"2026-02-17","updated_at":"2026-06-21"}]},"command_snippets":{"columns":["id","command_id","seq","lang","title","code","note"],"rows":[{"id":1,"command_id":1,"seq":0,"lang":"bash","title":"对最近 3 个提交做交互式变基","code":"git rebase -i HEAD~3","note":"把 pick 改成 squash 或 fixup 即可合并，改成 reword 可改提交信息。"},{"id":2,"command_id":1,"seq":1,"lang":"bash","title":"已经推到远端时强推","code":"git push --force-with-lease origin main","note":"用 --force-with-lease 而不是 --force，避免覆盖他人提交。"},{"id":3,"command_id":2,"seq":0,"lang":"bash","title":"单文件转换模板","code":"ffmpeg -i \"${input}\" -c:v libx265 -crf ${crf} -preset ${preset} -tag:v hvc1 -c:a copy \"${output}\"","note":"-c:a copy 直接复制音轨，不重新编码。"},{"id":4,"command_id":2,"seq":1,"lang":"bash","title":"目录批量处理","code":"for f in \"${input_dir}\"/*.mp4; do ffmpeg -i \"$f\" -c:v libx265 -crf ${crf} -preset ${preset} -tag:v hvc1 -c:a copy \"${output_dir}/$(basename \"${f%.*}\")${suffix}.mp4\"; done","note":"建议先拿一个文件试参数，再跑整目录。"},{"id":5,"command_id":3,"seq":0,"lang":"powershell","title":"清空 WinINET 代理","code":"Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings' -Name ProxyEnable -Value 0\nRemove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings' -Name ProxyServer -ErrorAction SilentlyContinue","note":"执行后需要重开浏览器或应用才会读到新配置。"},{"id":6,"command_id":3,"seq":1,"lang":"powershell","title":"顺便重置 WinHTTP 代理","code":"netsh winhttp reset proxy","note":"服务类程序走的是 WinHTTP，与 WinINET 是两套配置。"},{"id":7,"command_id":4,"seq":0,"lang":"bash","title":"先看能释放多少","code":"docker system df","note":"养成先看后删的习惯。"},{"id":8,"command_id":4,"seq":1,"lang":"bash","title":"清理镜像、容器、网络、构建缓存","code":"docker system prune -a --volumes","note":"--volumes 会连数据卷一起删，确认没有需要保留的数据库卷再执行。"},{"id":9,"command_id":5,"seq":0,"lang":"bash","title":"常驻后台转发","code":"ssh -N -L ${local_port}:${remote_host}:${remote_port} ${user}@${jump_host}","note":"-N 只做转发不开 shell，配合 -f 可放后台。"},{"id":10,"command_id":5,"seq":1,"lang":"bash","title":"加保活参数，防止空闲断开","code":"ssh -N -o ServerAliveInterval=30 -L ${local_port}:${remote_host}:${remote_port} ${user}@${jump_host}","note":"网络抖动频繁时必加。"}]},"command_params":{"columns":["id","command_id","seq","name","alias","value_type","required","default_value","placeholder","enum_values","description"],"rows":[{"id":1,"command_id":1,"seq":0,"name":"count","alias":"n","value_type":"int","required":0,"default_value":"3","placeholder":"3","enum_values":null,"description":"往回整理几个提交"},{"id":2,"command_id":2,"seq":0,"name":"input_dir","alias":null,"value_type":"path","required":1,"default_value":null,"placeholder":"/videos/in","enum_values":null,"description":"源目录"},{"id":3,"co